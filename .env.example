# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode — set true only for offline demos without login
VITE_DEMO_MODE=false

# OpenAI (required for moderation + price advice)
OPENAI_API_KEY=

# Paystack (required for payments)
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Hubtel (optional — secondary MoMo + SMS + Ghana Card verify)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# Firebase Cloud Messaging (optional — driver job push on Android/iOS)
FCM_SERVER_KEY=

# TinyFish (optional — market price ingestion)
TINYFISH_API_KEY=

# Venice (optional — backup AI, NOT for moderation)
VENICE_API_KEY=

# Google Maps (optional — turn-by-turn)
GOOGLE_MAPS_API_KEY=

# Africa's Talking (optional — SMS OTP)
AT_API_KEY=
AT_USERNAME=

# WATI (optional — WhatsApp)
WATI_API_URL=
WATI_API_TOKEN=

# Web push (optional — PWA notifications)
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@agrolink.app

# PostHog analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry error tracking (optional)
VITE_SENTRY_DSN=
