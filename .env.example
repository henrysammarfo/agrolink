# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database password (Dashboard → Settings → Database) — required for npm run db:migrate
SUPABASE_DB_PASSWORD=
SUPABASE_DB_REGION=eu-west-1

# Demo mode — set true only for offline demos without login
VITE_DEMO_MODE=false

# Public site URL (required on Vercel — used for push links, emails)
SITE_URL=
VITE_SITE_URL=

# Internal cron / job auth (required on Vercel for delivery reassign cron)
CRON_SECRET=

# E2E test user (optional — defaults in scripts/e2e.mjs)
E2E_EMAIL=e2e@agrolink.app
E2E_PASSWORD=

# OpenAI (required for moderation + price advice)
OPENAI_API_KEY=

# Paystack (required for payments)
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Resend (free — 3,000 emails/month) — order updates + checkout OTP
RESEND_API_KEY=
RESEND_FROM_EMAIL=AgroLink <onboarding@resend.dev>

# Meta WhatsApp Cloud API (free tier — direct, no WATI)
# Create app at developers.facebook.com → WhatsApp → API Setup
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEST_NUMBER=

# Firebase Cloud Messaging (optional — driver job push on Android/iOS)
FCM_SERVER_KEY=

# TinyFish (optional — market price ingestion)
TINYFISH_API_KEY=

# Venice (optional — backup AI, NOT for moderation)
VENICE_API_KEY=

# Google Maps — geocoding, address search, driving routes
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Sentry error tracking (optional)
VITE_SENTRY_DSN=
SENTRY_PERSONAL_TOKEN=

# Africa's Talking (optional — SMS OTP)
AT_API_KEY=
AT_USERNAME=

# Web push (optional — PWA notifications)
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@agrolink.app

# PostHog analytics (optional) — US Cloud use https://us.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
